# ============================================================================
# packages/server/.env.example
# Copy to packages/server/.env and fill in. Vars without a default in
# packages/server/src/config/env.ts are required at boot.
# ============================================================================

# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV="development"                  # development | staging | production
PORT="3001"
HOST="0.0.0.0"
CLIENT_URL="http://localhost:5173"     # game client origin (CORS)
ADMIN_CLIENT_URL="http://localhost:3000"  # admin dashboard origin (CORS)

# ─── Datastores ─────────────────────────────────────────────────────────────
MONGODB_URI="mongodb://127.0.0.1:27017/hooked"
REDIS_URL="redis://127.0.0.1:6379"     # used for BullMQ queues + rate-limit

# ─── Solana RPC ─────────────────────────────────────────────────────────────
# Mainnet for production. Devnet/local fine for dev — Meteora DLMM is
# mainnet-only though, so LP cycle must run with LP_DRY_RUN=true on devnet.
SOLANA_RPC_URL="https://api.devnet.solana.com"
HELIUS_API_KEY=""                      # optional, used by some indexer paths

# ─── On-chain program ID ───────────────────────────────────────────────────
HOOKED_ROOMS_PROGRAM_ID="4ERUTWVN3aJP5tghEcZNd555NGcK3Jr8B21mnBB8JSMg"

# ─── Server-held keypairs ───────────────────────────────────────────────────
# All keypair vars accept either a JSON byte array ([1,2,3,...,64]) or a
# base58-encoded 64-byte secret key.
TREASURY_KEYPAIR=""
KEEPER_KEYPAIR=""
ADMIN_KEYPAIR=""

# ─── Admin authorization (off-chain) ────────────────────────────────────────
# Comma-separated list of pubkeys allowed to call admin tRPC endpoints.
ADMIN_WALLETS=""

# ============================================================================
# LP integration (Meteora DLMM SOL/USDC → top-3 yield distribution)
# ============================================================================

# ─── Master switches ────────────────────────────────────────────────────────
# Big on/off. When false, runRoomLifecycleTick skips both LP deploy and exit;
# system behaves exactly as it did before this feature (yield = 0).
FEATURES_LP_ENABLED="false"
# Hot-stop. true = no new deploys; existing positions still get exited.
LP_KILL_SWITCH="false"
# Devnet-safe mode. true = skip DLMM/Jupiter calls entirely, synthesize fake
# yield. Still performs withdraw_to_lp_manager on-chain so the full lifecycle
# is exercised. Set false ONLY when SOLANA_RPC_URL is mainnet.
LP_DRY_RUN="true"
# Only meaningful when LP_DRY_RUN=true. Synthetic yield amount per cycle.
# Set to e.g. 50000000 (0.05 SOL) to simulate a winning cycle in dev.
LP_DRY_RUN_YIELD_LAMPORTS="0"

# ─── Required when LP is on ─────────────────────────────────────────────────
# Off-chain wallet that holds principal during the LP cycle. Distinct from
# TREASURY_KEYPAIR so custody risk is bounded to one cycle's principal +
# the IL buffer balance.
LP_MANAGER_KEYPAIR=""
# Real SOL/USDC pool from https://dlmm.datapi.meteora.ag/pair/all
# The default in env.ts is a USDC/USDT pool — PLACEHOLDER ONLY. Override here.
# checkLpReady refuses to deploy on the placeholder when LP_DRY_RUN=false.
METEORA_POOL_ADDRESS=""
# Canonical mainnet USDC mint. Override only for devnet test mints.
USDC_MINT_ADDRESS="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
# Jupiter v6 quote+swap endpoint. Override for self-host or regional mirror.
JUPITER_API_URL="https://quote-api.jup.ag/v6"

# ─── Risk knobs ─────────────────────────────────────────────────────────────
# Minimum SOL balance LP_MANAGER must hold to absorb impermanent loss before
# a deploy fires. Size to ~5% of largest active room TVL. Default 0.5 SOL.
IL_BUFFER_LAMPORTS_MIN="500000000"
# Slippage tolerance for Jupiter swaps (basis points). 50 = 0.5%.
LP_SWAP_SLIPPAGE_BPS="50"
# Hours before closes_at to fire lpExit. 12h gives plenty of slack for
# remove → swap → vault transfer to settle before day-7. Don't drop below ~2h.
LP_EXIT_HOURS_BEFORE_CLOSE="12"


# 64-char hex string (32 bytes) used as the HMAC key in the off-chain
# fishing RNG. Rotate daily in production. If absent, cast.initiate fails
# loudly rather than silently using a weak default.
# Generate: openssl rand -hex 32
FISHING_DAILY_SEED_HEX=""

# Filesystem path to the apex-fish PNG directory served by the player client.
# Used by services/fishing/apexCatalog.ts to enumerate which fish the admin
# can pick from for an event. Default resolves to the sibling client package's
# public folder relative to the server source — override in production where
# the client is deployed separately.
APEX_FISH_DIR=""
