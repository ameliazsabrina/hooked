# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. NEVER commit a file with real secrets.

# --- Solana network ---
# Which Solana cluster to connect to. Use "mainnet-beta" for production.
# The client uses Solana's public default RPC (no Helius key required).
VITE_SOLANA_CLUSTER=devnet

# Helius RPC API key. Get one at https://dashboard.helius.dev/
# Reserved for future use — not currently used for the client RPC connection.
VITE_HELIUS_API_KEY=

# --- Backend gateway ---
# HTTP base URL of the server package (tRPC + REST). For local dev, the
# server defaults to http://localhost:3001. Set this to the same origin
# your server's CLIENT_URL allows.
VITE_GATEWAY_HTTP=http://localhost:3001

# Websocket URL for the realtime fishing gateway.
VITE_WS_URL=ws://localhost:3001/ws/gateway

# --- On-chain program IDs ---
# Public address of the deployed `hooked-rooms` program. The default below is
# the devnet ID; override for staging or mainnet.
VITE_HOOKED_ROOMS_PROGRAM_ID=4ERUTWVN3aJP5tghEcZNd555NGcK3Jr8B21mnBB8JSMg
