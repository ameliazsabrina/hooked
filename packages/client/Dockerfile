FROM node:20-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

FROM base AS build
COPY . .

RUN pnpm install --frozen-lockfile --ignore-scripts

ARG VITE_GATEWAY_HTTP
ARG VITE_WS_URL
ARG VITE_HELIUS_API_KEY
ARG VITE_HOOKED_PROGRAM_ID
ARG VITE_HOOKED_ROOMS_PROGRAM_ID
ARG VITE_MAGICBLOCK_RPC
ARG VITE_FEATURES_LP_ENABLED
ARG VITE_DEV_MODE
ARG VITE_SOLANA_CLUSTER

ENV VITE_GATEWAY_HTTP=$VITE_GATEWAY_HTTP
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_HELIUS_API_KEY=$VITE_HELIUS_API_KEY
ENV VITE_HOOKED_PROGRAM_ID=$VITE_HOOKED_PROGRAM_ID
ENV VITE_HOOKED_ROOMS_PROGRAM_ID=$VITE_HOOKED_ROOMS_PROGRAM_ID
ENV VITE_MAGICBLOCK_RPC=$VITE_MAGICBLOCK_RPC
ENV VITE_FEATURES_LP_ENABLED=$VITE_FEATURES_LP_ENABLED
ENV VITE_DEV_MODE=$VITE_DEV_MODE
ENV VITE_SOLANA_CLUSTER=$VITE_SOLANA_CLUSTER

RUN cd packages/shared && npx tsc

RUN cd packages/client && npx vite build

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /app/packages/client/dist /app/dist
WORKDIR /app
RUN npm install -g serve@14
CMD ["sh", "-c", "serve -s dist -l ${PORT:-3000}"]
