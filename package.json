{
  "name": "hooked",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @hooked/client --filter @hooked/server dev",
    "dev:client": "pnpm --filter @hooked/client dev",
    "dev:server": "pnpm --filter @hooked/server dev",
    "build": "pnpm --filter @hooked/shared build && pnpm --parallel --filter @hooked/client --filter @hooked/server build",
    "lint": "pnpm --parallel -r lint"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  }
}
